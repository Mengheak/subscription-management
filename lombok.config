# Stop Lombok from walking up past the project root looking for more configuration.
config.stopBubbling = true

# @RequiredArgsConstructor generates the constructor, so Spring annotations that belong on
# the injected parameter must be copied onto it. Without this, a @Qualifier declared on a
# final field is silently dropped and injection fails - or worse, picks the wrong bean.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
lombok.copyableAnnotations += org.springframework.context.annotation.Lazy

# Lombok-generated members are not part of the hand-written source; keep them out of
# coverage reports.
lombok.addLombokGeneratedAnnotation = true
